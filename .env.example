# Neon: conexión con pooler (la usa la app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# Neon: conexión directa, sin "-pooler" (la usan las migraciones de Prisma)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Usuario MASTER inicial que crea el seed
SEED_MASTER_EMAIL="master@example.com"
SEED_MASTER_PASSWORD="cambiar-esto"

# Firma de la cookie de sesión (mínimo 32 caracteres). Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Neon Object Storage (los escribe `neon deploy` / `neon env pull` en .env.local)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://br-XXXX.storage.c-N.us-east-1.aws.neon.tech"
AWS_REGION="us-east-1"
# URL pública del bucket: <AWS_ENDPOINT_URL_S3>/songs
STORAGE_PUBLIC_URL="https://br-XXXX.storage.c-N.us-east-1.aws.neon.tech/songs"
